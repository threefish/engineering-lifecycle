<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>scaffold</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-infrastructure</artifactId>
    <name>scaffold-infrastructure</name>
    <description>基础设施：MyBatis-Plus Entity / Mapper / 仓储适配 / MapStruct Convert</description>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>scaffold-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>scaffold-model</artifactId>
        </dependency>
        <!-- MyBatis-Plus（Boot 3 专用 starter）：BaseMapper / LambdaQueryWrapper / JacksonTypeHandler -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 分页插件 PaginationInnerInterceptor（3.5.9+ 独立模块，依赖 jsqlparser） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- MapStruct 注解（处理器在父 POM 统一配置） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
    </dependencies>
</project>