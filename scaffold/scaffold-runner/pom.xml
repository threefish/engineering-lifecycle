<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>scaffold</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>scaffold-runner</artifactId>
    <name>scaffold-runner</name>
    <description>唯一可执行模块：Application 启动类 + 配置 + SQLite 驱动</description>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>scaffold-facade</artifactId>
        </dependency>
        <!-- SQLite JDBC 驱动：版本由 Boot BOM 管理（3.49.1.0），仅运行期需要 -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>scaffold-runner</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.example.scaffold.runner.Application</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>